{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ilic.ch/schemas/semantic-snapshot-v1.schema.json",
  "title": "ilic semantic snapshot v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "abiVersion",
    "compilerVersion",
    "kind",
    "success",
    "cancelled",
    "roots",
    "documentVersions",
    "symbols",
    "references",
    "dependencies",
    "diagram",
    "documentation",
    "diagnostics",
    "logs"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "abiVersion": { "const": 1 },
    "compilerVersion": { "type": "string" },
    "kind": { "const": "semantic" },
    "success": { "type": "boolean" },
    "cancelled": { "type": "boolean" },
    "roots": { "type": "array", "items": { "type": "string" } },
    "documentVersions": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "missingModels": { "type": "array", "items": { "type": "string" } },
    "symbols": { "type": "array", "items": { "type": "object" } },
    "references": { "type": "array", "items": { "type": "object" } },
    "dependencies": { "type": "array", "items": { "type": "object" } },
    "diagram": {
      "type": "object",
      "required": ["nodes", "edges"],
      "properties": {
        "nodes": { "type": "array", "items": { "type": "object" } },
        "edges": { "type": "array", "items": { "type": "object" } }
      }
    },
    "documentation": { "$ref": "#/$defs/documentation" },
    "diagnostics": { "type": "array", "items": { "type": "object" } },
    "logs": { "type": "array", "items": { "type": "object" } }
  },
  "$defs": {
    "documentation": {
      "type": "object",
      "required": ["title", "sections", "models"],
      "properties": {
        "title": { "type": "string" },
        "sections": {
          "type": "array",
          "items": { "$ref": "#/$defs/section" }
        },
        "models": {
          "type": "array",
          "items": { "$ref": "#/$defs/model" }
        }
      }
    },
    "section": {
      "type": "object",
      "required": ["id", "title", "kind", "text", "level"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "kind": { "type": "string" },
        "text": { "type": "string" },
        "level": { "type": "integer", "minimum": 1 }
      }
    },
    "model": {
      "type": "object",
      "required": ["name", "uri", "topics", "viewables", "enumerations"],
      "properties": {
        "name": { "type": "string" },
        "uri": { "type": "string" },
        "title": { "type": "string" },
        "shortDescription": { "type": "string" },
        "topics": {
          "type": "array",
          "items": { "$ref": "#/$defs/topic" }
        },
        "viewables": {
          "type": "array",
          "items": { "$ref": "#/$defs/viewable" }
        },
        "enumerations": {
          "type": "array",
          "items": { "$ref": "#/$defs/enumeration" }
        }
      }
    },
    "topic": {
      "type": "object",
      "required": ["name", "viewables", "enumerations"],
      "properties": {
        "name": { "type": "string" },
        "documentation": { "type": "string" },
        "viewables": {
          "type": "array",
          "items": { "$ref": "#/$defs/viewable" }
        },
        "enumerations": {
          "type": "array",
          "items": { "$ref": "#/$defs/enumeration" }
        }
      }
    },
    "viewable": {
      "type": "object",
      "required": ["name", "kind", "isAbstract", "documentation", "rows"],
      "properties": {
        "name": { "type": "string" },
        "kind": {
          "enum": ["class", "structure", "view", "association"]
        },
        "isAbstract": { "type": "boolean" },
        "documentation": { "type": "string" },
        "rows": {
          "type": "array",
          "items": { "$ref": "#/$defs/row" }
        },
        "roles": {
          "type": "array",
          "items": { "$ref": "#/$defs/role" }
        },
        "uniqueness": {
          "type": "array",
          "items": { "$ref": "#/$defs/unique" }
        }
      }
    },
    "row": {
      "type": "object",
      "required": ["name", "cardinality", "type", "description"],
      "properties": {
        "name": { "type": "string" },
        "cardinality": { "type": "string" },
        "type": { "type": "string" },
        "range": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "role": {
      "type": "object",
      "required": ["name", "cardinality", "type", "description"],
      "properties": {
        "name": { "type": "string" },
        "cardinality": { "type": "string" },
        "type": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "unique": {
      "type": "object",
      "required": ["scope", "perBasket", "elements", "origin"],
      "properties": {
        "scope": { "enum": ["global", "local"] },
        "perBasket": { "type": "boolean" },
        "prefix": { "type": "string" },
        "elements": { "type": "array", "items": { "type": "string" } },
        "where": { "type": "string" },
        "origin": { "enum": ["direct", "inherited"] },
        "inheritedFrom": { "type": "string" }
      }
    },
    "enumeration": {
      "type": "object",
      "required": ["name", "documentation", "entries"],
      "properties": {
        "name": { "type": "string" },
        "documentation": { "type": "string" },
        "entries": {
          "type": "array",
          "items": { "$ref": "#/$defs/enumerationEntry" }
        }
      }
    },
    "enumerationEntry": {
      "type": "object",
      "required": ["value", "documentation"],
      "properties": {
        "value": { "type": "string" },
        "displayName": { "type": "string" },
        "documentation": { "type": "string" }
      }
    }
  }
}
